<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacer_medium"
    android:paddingEnd="@dimen/spacer_medium">

    <TextView
        android:id="@+id/emailTextLabel"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_extra_small"
        android:text="@string/email"
        android:textColor="?android:textColorSecondary" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="?android:editTextBackground"
        android:backgroundTint="?android:textColorSecondary"
        android:inputType="textEmailAddress"
        android:textColor="?android:textColorPrimary"
        android:textCursorDrawable="?android:textColorSecondary"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/emailErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_extra_small"
        android:text=""
        android:textColor="?android:colorAccent"
        android:textSize="@dimen/body_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/passwordTextLabel"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_medium"
        android:layout_marginBottom="@dimen/spacer_extra_small"
        android:text="@string/password"
        android:textColor="?android:textColorSecondary" />

    <EditText
        android:id="@+id/editTextTextPassword"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="?android:editTextBackground"
        android:backgroundTint="?android:textColorSecondary"
        android:inputType="textPassword"
        android:textColor="?android:textColorPrimary"
        android:textCursorDrawable="?android:textColorSecondary"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/passwordErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_extra_small"
        android:text=""
        android:textColor="?android:colorAccent"
        android:textSize="@dimen/body_text_size"
        android:visibility="gone" />

</LinearLayout>
