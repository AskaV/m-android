<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/common_login_padding_start"
    android:paddingEnd="@dimen/common_login_padding_end">

    <TextView
        android:id="@+id/emailTextLabel"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/common_login_margin_bottom_small"
        android:text="@string/email"
        android:textColor="@color/grayText2" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:inputType="textEmailAddress"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/passwordTextLabel"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_login_margin_top_medium"
        android:layout_marginBottom="@dimen/common_login_margin_bottom_small"
        android:text="@string/password"
        android:textColor="@color/grayText2" />

    <EditText
        android:id="@+id/editTextTextPassword"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="password"
        android:backgroundTint="@color/white"
        android:inputType="textPassword"
        android:textColor="@color/white" />

    <CheckBox
        android:id="@+id/checkBox"
        style="@style/SubheadingMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/white"
        android:text="@string/remember_me"
        android:textColor="@color/grayText2" />
</LinearLayout>
