<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacer_medium"
    android:paddingEnd="@dimen/spacer_medium">

    <TextView
        android:id="@+id/user_name_text"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_extra_small"
        android:text="@string/signup_extended_user_name"
        android:textColor="?android:textColorSecondary" />

    <EditText
        android:id="@+id/user_name_field"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:editTextBackground"
        android:backgroundTint="?android:textColorSecondary"
        android:importantForAutofill="no"
        android:textColor="?android:textColorPrimary"
        android:textCursorDrawable="?android:textColorSecondary"
        tools:ignore="LabelFor,TextFields" />

    <TextView
        android:id="@+id/user_name_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_extra_small"
        android:text=""
        android:textColor="?android:colorAccent"
        android:textSize="@dimen/body_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mobile_phone_text"
        style="@style/SubheadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_medium"
        android:layout_marginBottom="@dimen/spacer_extra_small"
        android:text="@string/signup_extended_mobile_phone"
        android:textColor="?android:textColorSecondary" />

    <EditText
        android:id="@+id/mobile_phone_field"
        style="@style/HeadingMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:editTextBackground"
        android:backgroundTint="?android:textColorSecondary"
        android:importantForAutofill="no"
        android:textColor="?android:textColorPrimary"
        android:textCursorDrawable="?android:textColorSecondary"
        tools:ignore="LabelFor,TextFields" />

    <TextView
        android:id="@+id/phone_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_extra_small"
        android:text=""
        android:textColor="?android:colorAccent"
        android:textSize="@dimen/body_text_size"
        android:visibility="gone" />
</LinearLayout>
