<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size
                android:width="20dp"
                android:height="20dp" />
            <solid android:color="?android:textColorPrimary" />
            <stroke
                android:width="@dimen/border_size"
                android:color="?android:textColorPrimary" />

        </shape>
    </item>
    <item
        android:bottom="@dimen/spacer_extra_small"
        android:drawable="@drawable/ic_check"
        android:left="@dimen/spacer_extra_small"
        android:right="@dimen/spacer_extra_small"
        android:top="@dimen/spacer_extra_small" />
</layer-list>