<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- light -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>

        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:textColorTertiary">@color/text_tertiary_light</item>

        <item name="colorAccent">@color/accent_light</item>
        <item name="colorError">@color/error_light</item>
        <item name="colorOnSecondary">@color/text_font_secondary_accent</item>
    </style>

    <!-- dark -->
    <style name="Theme.MyApplication_Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>

        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorTertiary">@color/text_tertiary_dark</item>

        <item name="colorAccent">@color/accent_dark</item>
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnSecondary">@color/text_font_secondary_dark_accent</item>

    </style>

    <!-- colored -->
    <style name="Theme.MyApplication_Colored" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_colored</item>

        <item name="android:textColorPrimary">@color/text_primary_colored</item>
        <item name="android:textColorSecondary">@color/text_secondary_colored</item>
        <item name="android:textColorTertiary">@color/text_tertiary_colored</item>

        <item name="colorAccent">@color/accent_colored</item>
        <item name="colorError">@color/error_colored</item>
        <item name="colorOnSecondary">@color/text_font_secondary_colored_accent</item>

    </style>

</resources>